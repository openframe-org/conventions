      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tanstack/eslint-plugin-query": "5.101.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3"
